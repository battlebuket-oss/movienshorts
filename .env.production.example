# Copy to .env.production and replace every CHANGE_ME value.
# Keep .env.production out of Git. Use a secret manager in hosted environments.

# Public HTTPS origins (no trailing slash)
NEXT_PUBLIC_APP_URL=https://app.example.com
BETTER_AUTH_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

# Generate independent random values; never reuse development/test secrets.
# Example: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
BACKEND_AUTH_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
APP_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_ALPHANUMERIC
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_ALPHANUMERIC

# Required video processing providers
ASSEMBLY_AI_API_KEY=
LLM=google-gla:gemini-3-flash-preview
GOOGLE_API_KEY=
# If using OpenAI instead, set LLM=openai:<supported-model> and OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Optional integrations
YOUTUBE_METADATA_PROVIDER=yt_dlp
YOUTUBE_DOWNLOAD_PROVIDER=yt_dlp
YOUTUBE_DATA_API_KEY=
# Google Cloud OAuth 2.0 Web client; callback must match the app URL below.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://app.example.com/api/youtube/callback
APIFY_API_TOKEN=
PEXELS_API_KEY=
WHISPER_MODEL_SIZE=medium
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=universal

# Database identity
POSTGRES_DB=supoclip
POSTGRES_USER=supoclip

# Auth and application behavior
DISABLE_SIGN_UP=false
NEXT_PUBLIC_LANDING_ONLY_MODE=false
SELF_HOST=true
AUTH_SIGNATURE_TTL_SECONDS=300
QUEUED_TASK_TIMEOUT_SECONDS=180

# Optional email/analytics/feedback
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_DOMAIN=
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# Leave billing credentials empty while SELF_HOST=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_CHECKOUT_URL=
STRIPE_CUSTOMER_PORTAL_URL=
REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_PRO_PRODUCT_IDS=
REVENUECAT_SCALE_PRODUCT_IDS=
